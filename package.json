    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "generate:dtos": "node src/scripts/generate-dtos.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.13",
